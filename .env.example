# Bật chế độ demo để xem portal mà chưa cần cấu hình Microsoft 365.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Microsoft Entra ID App Registration
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# SharePoint site / document library dùng cho kho tài liệu
SHAREPOINT_HOSTNAME=yourtenant.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/vietrobot-portal
SHAREPOINT_DRIVE_ID=

# Tùy chọn: danh sách Plan ID ngăn cách bởi dấu phẩy. Các plan có task được giao
# cho người dùng sẽ được tự động phát hiện; biến này bổ sung các plan còn trống.
PLANNER_PLAN_IDS=

# Team ID đang sử dụng Microsoft Teams Shifts cho chấm công
SHIFTS_TEAM_ID=

# Danh sách email HR/Admin được phép quản lý hồ sơ, ngăn cách bởi dấu phẩy
HR_ADMIN_EMAILS=hr@vietrobot.vn

# Hồ sơ được dùng khi chạy demo trang "Hồ sơ của tôi"
DEMO_EMPLOYEE_EMAIL=tim.nguyen@vietrobot.vn

# Email được phép quản lý tài sản/CCDC, ngăn cách bởi dấu phẩy
ASSET_ADMIN_EMAILS=it@vietrobot.vn,admin@vietrobot.vn

# URL src của iframe được tạo tại Viva Engage Embed widget.
# Chế độ production dùng iframe chính thức; chế độ demo dùng bảng tin mẫu trong portal.
VIVA_ENGAGE_EMBED_URL=
